// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  profileShape  String?   @default("circle") // Profile picture shape: circle, square, triangle
  source        String?   // Where did you hear about us?
  goals         String?   // What would you like to achieve with Ecoverse?
  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  feedback      Feedback[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Analysis {
  id        String   @id @default(cuid())
  userId    String
  imageUrl  String
  label     String   // Detected object from Clarifai
  type      String?  // Material type
  category  String?  // Type of waste
  degradability String? // How quickly it degrades
  environmentalImpact String? // JSON string of environmental impact array
  harms     String?  // JSON string of harms array
  disposal  String?  // JSON string of disposal instructions array
  potentialForReuse String? // Potential for reuse
  alternatives String? // JSON string of eco alternatives array
  recommendations String? // JSON string of recommendations object
  extraNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  message   String
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
} 